{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next",
    "fix": "npm-run-all --continue-on-error \"fix:*\"",
    "fix:eslint": "next typegen && eslint --max-warnings=0 --fix",
    "fix:knip": "knip --fix --allow-remove-files",
    "fix:markdownlint": "markdownlint --dot --fix .",
    "fix:pnpm-dedupe": "pnpm dedupe",
    "fix:prettier": "prettier --write .",
    "lint": "npm-run-all --continue-on-error \"lint:*\"",
    "lint:eslint": "next typegen && eslint --max-warnings=0",
    "lint:knip": "knip",
    "lint:markdownlint": "markdownlint --dot .",
    "lint:pnpm-dedupe": "pnpm dedupe --check",
    "lint:prettier": "prettier --check .",
    "lint:tsc": "next typegen && tsc --noEmit",
    "prepare": "husky",
    "start": "next start"
  },
  "lint-staged": {
    "**": [
      "prettier --write"
    ]
  },
  "prettier": "@kachkaev/prettier-config",
  "dependencies": {
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@bprogress/core": "1.3.4",
    "@bprogress/next": "3.2.12",
    "@formatjs/intl": "4.1.18",
    "@kachkaev/eslint-config-next": "1.2.0",
    "@kachkaev/markdownlint-config": "1.0.1",
    "@kachkaev/prettier-config": "2.2.1",
    "@next/eslint-plugin-next": "16.3.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tailwindcss/postcss": "4.3.3",
    "@tsconfig/next": "2.0.6",
    "@tsconfig/node-ts": "23.6.4",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "js-yaml": "5.2.3",
    "knip": "6.31.0",
    "lint-staged": "17.3.0",
    "markdownlint-cli": "0.49.1",
    "next": "16.3.0",
    "npm-run-all2": "9.0.3",
    "postcss": "8.5.25",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "zod": "4.4.3"
  },
  "packageManager": "pnpm@11.19.0",
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
